    <string name="settings_summary_github">אתה יכול להוריד את ה-APK הבנוי מראש מפרויקט הקוד הפתוח Activity Launcher ב-GitHub. משתמשים מתקדמים יכולים גם לחקור את קוד המקור, לתמוך במפתחים ולתרום בתרגומים או בקשות משיכה.</string>
    <string name="settings_summary_hide_private">הסתר פעילויות פרטיות (לא מיוצאות ומושבתות), שלא ניתן להתחיל ללא גישת שורש</string>
    <string name="settings_summary_pro_version">רוצה לתמוך באפליקציה ולהסיר פרסומות? קבל את Activity Launcher Pro ב-Google Play - זה עוזר לממן את הפיתוח והוא בקוד פתוח מלא.</string>
    <string name="settings_summary_support_discord">הצטרפו לשרת הדיסקורד שלנו לתמיכה, בקשות לתכונות ודיוני קהילה.</string>
